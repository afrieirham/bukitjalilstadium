{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bukitjalilstadium",
  "pages_build_output_dir": "./build/client",
  "compatibility_date": "2026-09-21",

  // This file is the source of truth for the Pages project, so the dashboard
  // can manage Secrets only. The BUCKET (R2) and RATE_LIMIT (KV) bindings are
  // inserted right after compatibility_date by
  // new/scripts/setup-contribute-credentials.sh, which also fills in the
  // Turnstile site key below.

  "vars": {
    "GITHUB_REPO": "afrieirham/bukitjalilstadium",
    // Public Turnstile site key, served to the browser by /api/config. While
    // it is empty, the form refuses to submit rather than submitting without a
    // bot check.
    "TURNSTILE_SITE_KEY": ""
  }
}
